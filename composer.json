{
    "name": "omnistate/national-archives-uk",
    "type": "library",
    "description": "Omnistate National Archives UK: the Discovery catalogue of the UK's National Archives and 2,500 other archives - documents that name a person (wills, service records, parish papers), with their reference. A catalogue, not civil registration.",
    "keywords": [
        "genealogy",
        "archives",
        "national archives",
        "discovery",
        "united kingdom",
        "catalogue",
        "omnistate"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnistate": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnistate\\NationalArchivesUk\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnistate\\NationalArchivesUk\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
